BOT_TOKEN=YOUR_TOKEN_HERE

# URL сервиса на Render, без слеша в конце. Нужен для self-ping и авторегистрации вебхука
EXTERNAL_URL=https://<service-name>.onrender.com

# Upstash Redis — хранение состояний между шагами диалога
REDIS_URL=https://<db>.upstash.io
REDIS_TOKEN=YOUR_UPSTASH_TOKEN

# Имя бота для формирования ссылок
BOT_USERNAME=ph_editot_bot
